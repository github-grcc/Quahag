                {
                    "name": "UBSAN_OPTIONS",
                    "value": "halt_on_error=1:abort_on_error=1:print_stacktrace=1"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
